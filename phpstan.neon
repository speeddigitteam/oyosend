includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    level: 6

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes

    stubFiles:
        # Third-party typing gap, see the file.
        - phpstan/stubs/TenantCollection.stub

    tmpDir: storage/framework/cache/phpstan
