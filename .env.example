APP_NAME=Oyosend
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Root (central) domain. Tenants live on {tenant}.APP_DOMAIN, the Super Admin
# panel on admin.APP_DOMAIN. APP_URL must point at the central site and carry
# the port the app is served on (it is reused for every generated URL).
#   Sail:            APP_URL=http://localhost        (APP_PORT=80)
#   php artisan serve: APP_URL=http://localhost:8000
APP_DOMAIN=localhost
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# The application clock is always UTC (config/app.php). Each workspace has
# its own display timezone; the default for new ones is in config/platform.php.

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (values below match Laravel Sail; use 127.0.0.1 / your own
# --- credentials when running PHP natively, e.g. Laragon or Herd).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=oyosend
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Keep this null: sessions are host-only so a login on one workspace is never
# valid on another workspace's subdomain.
SESSION_DOMAIN=null
# Set to true wherever the site is served over HTTPS.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk that holds private, tenant-prefixed files (see config/filesystems.php).
TENANT_FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

# predis works without the phpredis extension (Windows, CI, Sail alike).
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SCOUT_DRIVER=database

# Sail ships Mailpit (dashboard on :8025). Natively, MAIL_MAILER=log writes
# outgoing mail - including invitation links - to storage/logs/laravel.log.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@oyosend.test"
MAIL_FROM_NAME="${APP_NAME}"

# Super Admin panel. Two-factor authentication is always enforced in
# production; this switch only relaxes it for local development.
PLATFORM_REQUIRE_2FA=true

# Who may sign up on the central site: open, approval (a Super Admin approves
# each workspace) or closed. Only the default: the panel can change it.
REGISTRATION_MODE=open

# --- Platform billing (what the platform charges its tenants)
# Printed on the invoices it issues.
BILLING_ISSUER_NAME="${APP_NAME}"
BILLING_ISSUER_ADDRESS=
BILLING_ISSUER_EMAIL=
BILLING_ISSUER_TAX_ID=
# BILLING_INVOICE_PREFIX=INV

# SSLCommerz hosted checkout. Leave the store id empty to keep the gateway
# switched off: the billing page then says no online payment is configured.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# --- Behind a load balancer or reverse proxy
# Addresses or CIDR ranges of the proxies (comma separated), or * when the
# application can only be reached through one. Empty: forwarded headers are ignored.
# TRUSTED_PROXIES=
# Content-Security-Policy: report-only (default), enforce, or off.
# SECURITY_CSP=report-only

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
