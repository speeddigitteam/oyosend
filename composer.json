{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "oyosend/platform",
    "type": "project",
    "description": "Oyosend - multi-tenant business management platform.",
    "keywords": [
        "laravel",
        "saas",
        "multi-tenant"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^3.1",
        "inertiajs/inertia-laravel": "^3.5",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.50",
        "laravel/scout": "^11.9",
        "laravel/tinker": "^3.0",
        "pragmarx/google2fa": "^9.1",
        "predis/predis": "^3.6",
        "pusher/pusher-php-server": "7.3.0",
        "spatie/laravel-permission": "^8.3",
        "stancl/tenancy": "^3.10",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.68",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force --seed",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#2f8f7a,#d9783a,#6b7f96\" \"php artisan serve --host=127.0.0.1 --port=8000\" \"php artisan queue:listen --queue=notifications,webhooks,default,billing,automation,campaigns,ai --tries=1 --timeout=0\" \"npm run dev\" --names=server,queue,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "ext-pcntl": "8.4.13",
            "ext-posix": "8.4.13"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
